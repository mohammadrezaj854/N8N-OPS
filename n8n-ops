#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="N8N-OPS"
INSTALL_DIR="/opt/n8n-ops"
DATA_DIR="/opt/n8n"
COMPOSE_FILE="$DATA_DIR/compose.yaml"
ENV_FILE="$DATA_DIR/.env"
LOG_DIR="/var/log/n8n-ops"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/ops.log"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; CYAN=$'\033[0;36m'; RESET=$'\033[0m'
log(){ echo "[$(date '+%F %T')] $*" | tee -a "$LOG_FILE"; }
ok(){ echo "${GREEN}[+]${RESET} $*"; }
warn(){ echo "${YELLOW}[!]${RESET} $*"; }
err(){ echo "${RED}[-]${RESET} $*" >&2; }
need_root(){ [[ $EUID -eq 0 ]] || { err "Run with sudo: sudo n8n-ops"; exit 1; }; }
has_compose(){ docker compose version >/dev/null 2>&1; }
compose(){ (cd "$DATA_DIR" && docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"); }
confirm(){ read -r -p "$1 [y/N]: " a; [[ "$a" =~ ^[Yy]$ ]]; }
pause(){ read -r -p "Press Enter to continue..." _; }
header(){ clear 2>/dev/null || true; echo "${CYAN}==============================================${RESET}"; echo "${CYAN}             N8N-OPS SERVER MANAGER           ${RESET}"; echo "${CYAN}==============================================${RESET}"; }

detect(){
  echo "OS: $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}")"
  echo "Kernel: $(uname -r)"
  echo "RAM: $(free -h | awk '/Mem:/ {print $2 " total, " $7 " available"}')"
  echo "Disk: $(df -h / | awk 'NR==2 {print $4 " free of " $2}')"
  if command -v docker >/dev/null 2>&1; then
    docker --version
    has_compose && docker compose version || warn "Docker Compose v2 plugin not available"
    docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
  else
    warn "Docker is not installed"
  fi
  if [[ -f "$COMPOSE_FILE" ]]; then
    echo "Compose: $COMPOSE_FILE"
    [[ -f "$ENV_FILE" ]] && echo ".env: present (values hidden)" || warn ".env missing"
  else
    warn "N8N-OPS compose file not found at $COMPOSE_FILE"
  fi
}

install_prereqs(){
  need_root
  . /etc/os-release
  [[ "${ID:-}" == "ubuntu" || "${ID_LIKE:-}" == *debian* ]] || { err "Supported OS: Ubuntu/Debian"; return 1; }
  apt-get update
  apt-get install -y ca-certificates curl gnupg openssl jq git ufw unattended-upgrades
  if ! command -v docker >/dev/null 2>&1; then
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL "https://download.docker.com/linux/ubuntu/gpg" -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    . /etc/os-release
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu ${UBUNTU_CODENAME:-$VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  elif ! has_compose; then
    apt-get update
    apt-get install -y docker-compose-plugin
  fi
  systemctl enable --now docker
  ok "Prerequisites installed"
}

generate_env(){
  need_root
  mkdir -p "$DATA_DIR"
  if [[ -e "$ENV_FILE" ]]; then
    warn "Existing .env found. It will NOT be overwritten."
    return 1
  fi
  local pgpass enc runner searx
  pgpass="$(openssl rand -hex 24)"
  enc="$(openssl rand -hex 32)"
  runner="$(openssl rand -hex 32)"
  searx="$(openssl rand -hex 32)"
  cat > "$ENV_FILE" <<EOF
# Generated by N8N-OPS. Keep this file private (chmod 600).
N8N_VERSION=2.48.7
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=${pgpass}
N8N_ENCRYPTION_KEY=${enc}
N8N_RUNNERS_AUTH_TOKEN=${runner}
SEARXNG_SECRET=${searx}
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
N8N_PROXY_HOPS=1
N8N_EDITOR_BASE_URL=http://localhost:5678/
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,n8n,postgres,n8n-postgres,n8n-runners,searxng,sandbox-api
EOF
  chmod 600 "$ENV_FILE"
  ok "Secrets generated in $ENV_FILE"
}

install_stack(){
  need_root
  if [[ -f "$COMPOSE_FILE" ]]; then
    warn "Existing compose.yaml detected. Automatic replacement is blocked."
    warn "Use Diagnostics/Backup first. Existing installations are managed, not overwritten."
    return 1
  fi
  if docker ps -a --format '{{.Names}}' | grep -Eq '^(n8n|n8n-postgres|n8n-runners)$'; then
    err "Existing n8n containers detected. Refusing fresh install to protect data."
    return 1
  fi
  install_prereqs
  generate_env || return 1
  cp "$INSTALL_DIR/templates/compose.yaml" "$COMPOSE_FILE"
  chmod 640 "$COMPOSE_FILE"
  (cd "$DATA_DIR" && docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" config -q)
  compose pull
  compose up -d
  ok "n8n stack started"
  echo "Open http://SERVER-IP:5678 (port is currently bound to all interfaces only if compose says so)."
}

backup(){
  need_root
  [[ -f "$ENV_FILE" ]] || { err "No $ENV_FILE"; return 1; }
  local dest="$DATA_DIR/backups/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dest"; chmod 700 "$dest"
  cp -a "$ENV_FILE" "$dest/.env"
  [[ -f "$COMPOSE_FILE" ]] && cp -a "$COMPOSE_FILE" "$dest/compose.yaml"
  if docker ps --format '{{.Names}}' | grep -qx 'n8n-postgres'; then
    docker exec n8n-postgres sh -lc 'pg_dumpall -U "$POSTGRES_USER"' > "$dest/postgres-all.sql"
  fi
  if docker volume inspect n8n_data >/dev/null 2>&1; then
    docker run --rm -v n8n_data:/data:ro -v "$dest":/backup alpine:3.20 sh -c 'cd /data && tar czf /backup/n8n-data.tar.gz .'
  fi
  chmod -R go-rwx "$dest"
  ok "Backup created: $dest"
}

update_stack(){
  need_root
  [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]] || { err "N8N-OPS installation not found"; return 1; }
  backup
  compose config -q
  compose pull
  compose up -d --remove-orphans
  ok "Images updated/reconciled. Database volume was not removed."
}

restart_stack(){ need_root; compose up -d; }
stop_stack(){ need_root; warn "This stops containers but preserves all volumes."; confirm "Stop the stack?" && compose stop; }
logs_stack(){ need_root; compose logs --tail=150 -f; }
status_stack(){ need_root; compose ps; }
diagnostics(){
  need_root
  echo "===== SYSTEM ====="; detect
  echo "===== DOCKER HEALTH ====="; docker info --format 'Docker={{.ServerVersion}} Storage={{.Driver}}' 2>&1 || true
  echo "===== PORTS ====="; ss -lntup 2>/dev/null | grep -E ':(80|88|443|5678|5679|18118|8118|10808|10809)\b' || true
  echo "===== RECENT N8N LOGS ====="; docker logs --tail 80 n8n 2>&1 || true
  echo "===== POSTGRES HEALTH ====="; docker exec n8n-postgres pg_isready 2>&1 || true
  echo "===== HTTP LOCAL ====="; curl -sS -o /dev/null -w 'HTTP %{http_code}\n' http://127.0.0.1:5678/ || true
}

configure_domain(){
  need_root
  [[ -f "$ENV_FILE" ]] || { err "Install n8n first"; return 1; }
  read -r -p "Domain (example.com): " domain
  [[ "$domain" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { err "Invalid domain"; return 1; }
  sed -i "s/^N8N_HOST=.*/N8N_HOST=${domain}/; s|^N8N_PROTOCOL=.*|N8N_PROTOCOL=https|; s|^WEBHOOK_URL=.*|WEBHOOK_URL=https://${domain}/|; s|^N8N_EDITOR_BASE_URL=.*|N8N_EDITOR_BASE_URL=https://${domain}/|" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  ok "Domain variables updated. Configure DNS A/AAAA to this VPS, then install Caddy reverse proxy."
}

install_caddy(){
  need_root
  [[ -f "$ENV_FILE" ]] || { err "Install n8n first"; return 1; }
  local domain
  domain="$(grep '^N8N_HOST=' "$ENV_FILE" | cut -d= -f2-)"
  [[ "$domain" != "localhost" && -n "$domain" ]] || { err "Set a real domain first using option 9"; return 1; }
  printf '%s {\n  encode gzip\n  reverse_proxy n8n:5678\n}\n' "$domain" > "$DATA_DIR/Caddyfile"
  chmod 640 "$DATA_DIR/Caddyfile"
  compose config -q
  compose --profile web up -d
  ok "Caddy enabled. Ensure DNS points to this server and ports 80/443 are reachable."
}

install_xray(){
  need_root
  mkdir -p "$DATA_DIR/xray"
  if [[ ! -s "$DATA_DIR/xray/config.json" ]]; then
    err "No Xray config found at $DATA_DIR/xray/config.json"
    echo "Place your own valid Xray client/server config there first."
    echo "The bundled service exposes local SOCKS/HTTP ports only (127.0.0.1:10808/10809)."
    return 1
  fi
  compose config -q
  compose --profile xray up -d xray
  ok "Xray container started"
}

configure_proxy(){
  need_root
  [[ -f "$ENV_FILE" ]] || { err "Install n8n first"; return 1; }
  read -r -p "HTTP proxy URL (e.g. http://172.18.0.1:18118), blank to clear: " proxy
  if [[ -n "$proxy" && ! "$proxy" =~ ^https?:// ]]; then err "Proxy URL must start http:// or https://"; return 1; fi
  sed -i '/^HTTP_PROXY=/d; /^HTTPS_PROXY=/d' "$ENV_FILE"
  printf 'HTTP_PROXY=%s\nHTTPS_PROXY=%s\n' "$proxy" "$proxy" >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  warn "Proxy env changed. Recreate affected containers with option 4."
}

firewall(){
  need_root
  command -v ufw >/dev/null || apt-get install -y ufw
  ufw allow OpenSSH
  ufw allow 80/tcp
  ufw allow 443/tcp
  warn "Port 5678 is intentionally NOT opened by UFW. Prefer Caddy HTTPS."
  confirm "Enable UFW now?" && ufw --force enable
  ufw status verbose
}

remove_stack(){
  need_root
  warn "This removes containers only. Volumes and data are preserved."
  confirm "Run docker compose down WITHOUT -v?" || return 0
  compose down
  ok "Containers removed; volumes preserved."
}

menu(){
 while true; do
  header
  echo "  1) Install prerequisites (Docker/Compose)"
  echo "  2) Fresh install n8n + PostgreSQL + Runners + SearXNG"
  echo "  3) Status / detect existing installation"
  echo "  4) Restart / recreate services"
  echo "  5) Update images (automatic backup first)"
  echo "  6) Backup database + n8n data + configuration"
  echo "  7) Live logs"
  echo "  8) Diagnostics (502 / DB / ports / proxy)"
  echo "  9) Configure domain + webhook URLs"
  echo " 10) Enable Caddy HTTPS reverse proxy"
  echo " 11) Configure HTTP/HTTPS proxy for containers"
  echo " 12) Configure UFW firewall"
  echo " 13) Install/start Xray (requires your config.json)"
  echo " 14) Stop stack (preserve data)"
  echo " 15) Remove containers (preserve volumes)"
  echo "  0) Exit"
  echo
  read -r -p "Select: " choice
  case "$choice" in
   1) install_prereqs;;
   2) install_stack;;
   3) detect; status_stack 2>/dev/null || true;;
   4) restart_stack;;
   5) update_stack;;
   6) backup;;
   7) logs_stack;;
   8) diagnostics;;
   9) configure_domain;;
   10) install_caddy;;
   11) configure_proxy;;
   12) firewall;;
   13) install_xray;;
   14) stop_stack;;
   15) remove_stack;;
   0) exit 0;;
   *) warn "Invalid option";;
  esac
  pause
 done
}

if [[ "${1:-}" == "--diagnose" ]]; then diagnostics; exit; fi
if [[ "${1:-}" == "--status" ]]; then detect; status_stack 2>/dev/null || true; exit; fi
menu
